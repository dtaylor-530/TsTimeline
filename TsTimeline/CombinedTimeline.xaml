<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:timelineControl="clr-namespace:TsTimeline"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    >

    <timelineControl:WidthToMarginConverter x:Key="WidthToMarginConverter"></timelineControl:WidthToMarginConverter>
    <timelineControl:MultiplyConverter x:Key="MultiplyConverter"/>

    <Style TargetType="{x:Type timelineControl:CombinedTimeline}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <timelineControl:CustomPanel 
                        PanelType="{Binding PanelType, RelativeSource={RelativeSource AncestorType=TreeView}}" 
                        ViewportX="{Binding ViewportX, RelativeSource={RelativeSource AncestorType=TreeView}}"  
                        ViewportY="{Binding ViewportY, RelativeSource={RelativeSource AncestorType=TreeView}}"  
                        Direction="Up"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type timelineControl:CombinedTimeline}">
                    <Grid>
                            <timelineControl:MeasureRenderer  
                                x:Name="PART_MEASURE_RENDERER"
                                Grid.Column="1"
                                ValueConverter="{TemplateBinding ValueConverter}"
                                Height="{Binding ActualHeight , ElementName=PART_SCROLL_VIEWER}"
                                Width="{Binding ActualWidth , ElementName=PART_SCROLL_VIEWER}"
                                Alter0="{TemplateBinding Alter0}"
                                Alter1="{TemplateBinding Alter1}"
                                Viewport="{TemplateBinding ViewportX}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom" />
                        
                        
                            <timelineControl:MeasureRenderer  
                                x:Name="PART_Y_MEASURE_RENDERER"
                                Grid.Column="1"
                                ValueConverter="{TemplateBinding ValueConverter}"
                                Height="{Binding ActualHeight , ElementName=PART_SCROLL_VIEWER}"
                                Width="{Binding ActualWidth , ElementName=PART_SCROLL_VIEWER}"
                                TickMargin="{TemplateBinding TickMargin}"
                                Alter0="{TemplateBinding Alter0}"
                                Alter1="{TemplateBinding Alter1}"
                                Viewport="{TemplateBinding ViewportY}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom" />


                            <ScrollViewer HorizontalAlignment="Stretch" 
                                          VerticalAlignment="Stretch"
                                      Grid.Column="1"
                                      Margin="0,0,0,0"
                                      x:Name="PART_SCROLL_VIEWER"
                                      Background="Transparent"
                                      CanContentScroll="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden"
                                      HorizontalContentAlignment="Left">
                                <ItemsPresenter x:Name="PART_ITEMS_PRESENTER" HorizontalAlignment="Left"/>
                            </ScrollViewer>


                        <timelineControl:Timeline 
                                x:Name="PART_TIMELINE"
                                Grid.Column="1"
                                Direction="{TemplateBinding Direction}"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left"                            
                                Viewport="{TemplateBinding ViewportX}"
                            Width="{Binding ActualWidth , ElementName=PART_SCROLL_VIEWER}"
                            Height="{Binding ActualHeight , ElementName=PART_SCROLL_VIEWER}">
                            </timelineControl:Timeline>
                    </Grid>                  
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>