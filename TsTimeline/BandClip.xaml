<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tsTimeline="clr-namespace:TsTimeline">
    
    <Style x:Key="BandClipStyle" TargetType="{x:Type tsTimeline:ClipBase}" BasedOn="{StaticResource {x:Type tsTimeline:ClipBase}}">
        <Setter Property="Background" >
            <Setter.Value>
                <SolidColorBrush Color="CornflowerBlue" Opacity="0.5"></SolidColorBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tsTimeline:ClipBase}" >

                        <Border
                                        x:Name="PART_CENTER" 
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Width="{TemplateBinding Width}"
                                        Height="{TemplateBinding Height}" ToolTip="{TemplateBinding EndValue}"/>
             
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>