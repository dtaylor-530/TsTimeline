<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:timelineControl="clr-namespace:TsTimeline">

    <Style TargetType="{x:Type timelineControl:ClipBase}">
        <!--<Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />-->
        <Setter Property="Viewport" Value="{Binding Viewport , RelativeSource={RelativeSource AncestorType=TreeView}}" />
        <Setter Property="Height" Value="{Binding TrackHeight , RelativeSource={RelativeSource AncestorType=TreeView}}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Canvas IsItemsHost="True" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type timelineControl:ClipBase}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>