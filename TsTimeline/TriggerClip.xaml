<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:timelineControl="clr-namespace:TsTimeline">
    
    <Style x:Key="TriggerClipStyle" TargetType="{x:Type timelineControl:ClipBase}" BasedOn="{StaticResource {x:Type timelineControl:ClipBase}}">
        <Style.Resources>
            <Style TargetType="Thumb">
                <Setter Property="Height"
                        Value="{Binding ActualHeight , RelativeSource={RelativeSource AncestorType={x:Type Canvas}}}" />
                <Setter Property="Width" Value="20" />
                <!--つまみの見た目-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Path Stroke="{TemplateBinding BorderBrush}"
                                  Margin="{TemplateBinding Padding}"
                                  Fill="{TemplateBinding Background}"
                                  Stretch="Fill"
                                  StrokeThickness="1"
                                  Data="M 0,0 L 1,1 L 0,2 L -1,1 Z" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="Red" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Canvas x:Name="PART_CANVAS"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            ClipToBounds="{TemplateBinding ClipToBounds}">
                        <Thumb x:Name="PART_THUMB" Background="OrangeRed" Opacity="0.7" Padding="6,3"         Cursor="Hand"/>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>