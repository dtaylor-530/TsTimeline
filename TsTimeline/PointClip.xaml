<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tsTimeline="clr-namespace:TsTimeline">


    <Style x:Key="PointClipStyle" TargetType="{x:Type tsTimeline:ClipBase}" BasedOn="{StaticResource {x:Type tsTimeline:ClipBase}}">
        <Setter Property="Width" Value="4"></Setter>
        <Setter Property="Height" Value="4"></Setter>
        <Setter Property="Background" >
            <Setter.Value>
                <SolidColorBrush Color="Coral" Opacity="0.5"></SolidColorBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tsTimeline:ClipBase}" >
                    <Ellipse
                      x:Name="PART_POINT" 
                      Fill="{TemplateBinding Background}"
                      Width="{TemplateBinding Width}"
                      Height="{TemplateBinding Height}" >
                        <Ellipse.ToolTip>
                            <StackPanel>
                                <TextBlock Text="{Binding X, RelativeSource={RelativeSource TemplatedParent}}"></TextBlock>
                                <TextBlock Text="{Binding Y, RelativeSource={RelativeSource TemplatedParent}}"></TextBlock>
                            </StackPanel>
                        </Ellipse.ToolTip>
                    </Ellipse>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    

</ResourceDictionary>