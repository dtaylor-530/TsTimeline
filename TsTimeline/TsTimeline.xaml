<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:timelineControl="clr-namespace:TsTimeline"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors">

    <timelineControl:WidthToMarginConverter x:Key="WidthToMarginConverter"></timelineControl:WidthToMarginConverter>
    <timelineControl:MultiplyConverter x:Key="MultiplyConverter"/>

    <Style TargetType="{x:Type timelineControl:TsTimeline}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <!--<Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel IsItemsHost="True"></StackPanel>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type timelineControl:TsTimeline}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="16" VerticalAlignment="Bottom" Background="#FFE3E3E3"
                                BorderThickness="0" />
                        <ScrollViewer Grid.Column="0" Margin="0,15,0,0">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <ScrollContentPresenter
                                            CanContentScroll="{TemplateBinding CanContentScroll}"
                                            Content="{TemplateBinding Content}"
                                            Margin="{TemplateBinding Padding}"
                                            x:Name="PART_ScrollContentPresenter" />
                                        <Grid Visibility="Collapsed">
                                            <ScrollBar x:Name="PART_VerticalScrollBar" />
                                            <ScrollBar x:Name="PART_HorizontalScrollBar" />
                                        </Grid>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <b:Interaction.Behaviors>
                                <timelineControl:ScrollViewerBindBehavior
                                    Target="{Binding ElementName=PART_SCROLL_VIEWER}" />
                            </b:Interaction.Behaviors>
                            <ItemsControl ItemsSource="{TemplateBinding ItemsSource}" 
                                          ItemTemplate="{TemplateBinding ItemTemplate}"
                                          ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        </ScrollViewer>
                        <timelineControl:MeasureRenderer  
                            x:Name="PART_MEASURE_RENDERER"
                            Grid.Column="1"
                            ValueConverter="{TemplateBinding ValueConverter}"
                            Height="{Binding ActualHeight , ElementName=PART_SCROLL_VIEWER}"                                             
                            TickMargin="{TemplateBinding TickMargin}"
                            Alter0="{TemplateBinding Alter0}"
                            Alter1="{TemplateBinding Alter1}"
                            Viewport="{TemplateBinding Viewport}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top" />

                        <timelineControl:Timeline 
                            x:Name="PART_TIMELINE"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Viewport="{TemplateBinding Viewport}"
                            Height="{Binding ActualHeight , ElementName=PART_SCROLL_VIEWER}">
                        </timelineControl:Timeline>

                        <ScrollViewer HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Grid.Column="1"
                                      Margin="0,15,0,0"
                                      x:Name="PART_SCROLL_VIEWER"
                                      Background="Transparent"
                                      CanContentScroll="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      HorizontalContentAlignment="Left">
                            <ItemsPresenter x:Name="ItemsPresenter" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>