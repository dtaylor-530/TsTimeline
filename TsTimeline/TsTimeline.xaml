<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:timelineControl="clr-namespace:TsTimeline"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors">

    <timelineControl:WidthToMarginConverter x:Key="WidthToMarginConverter"></timelineControl:WidthToMarginConverter>
    <timelineControl:MultiplyConverter x:Key="MultiplyConverter"/>
    <timelineControl:ViewportDirectionConverter x:Key="ViewportDirectionConverter"/>

    <Style TargetType="{x:Type timelineControl:TsTimeline}">

        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <timelineControl:CustomPanel
                        PanelType="ScrollAwareStackPanel"
                        Direction="Down"
                        ViewportX="{Binding ViewportX, RelativeSource={RelativeSource AncestorType=TreeView}}"  
                        ViewportY="{Binding ViewportY, RelativeSource={RelativeSource AncestorType=TreeView}}"  
                        IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type timelineControl:TsTimeline}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" Margin="0,15,0,0">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <ScrollContentPresenter
                                            CanContentScroll="{TemplateBinding CanContentScroll}"
                                            Content="{TemplateBinding Content}"
                                            Margin="{TemplateBinding Padding}"
                                            x:Name="PART_ScrollContentPresenter" />
                                        <Grid Visibility="Collapsed">
                                            <ScrollBar x:Name="PART_VerticalScrollBar" />
                                            <ScrollBar x:Name="PART_HorizontalScrollBar" />
                                        </Grid>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <b:Interaction.Behaviors>
                                <timelineControl:ScrollViewerBindBehavior
                                    Target="{Binding ElementName=PART_SCROLL_VIEWER}" />
                            </b:Interaction.Behaviors>
                            <ItemsControl ItemsSource="{TemplateBinding ItemsSource}" 
                                          ItemTemplate="{TemplateBinding ItemTemplate}"
                                          ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        </ScrollViewer>
                        <timelineControl:MeasureRenderer  
                            x:Name="PART_MEASURE_RENDERER"
                            Grid.Column="1"
                            ValueConverter="{TemplateBinding ValueConverter}"
                            Height="{Binding ActualHeight , ElementName=PART_SCROLL_VIEWER}"
                            Width="{Binding ActualWidth , ElementName=PART_SCROLL_VIEWER}"                                         
                            TickMargin="{TemplateBinding TickMargin}"
                            Alter0="{TemplateBinding Alter0}"
                            Alter1="{TemplateBinding Alter1}"
                            Viewport="{TemplateBinding ViewportX}"
                            ItemCount="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Items.Count}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top" />

                      

                        <ScrollViewer HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Grid.Column="1"
                                      Margin="0,15,0,0"
                                      x:Name="PART_SCROLL_VIEWER"
                                      Background="Transparent"
                                      CanContentScroll="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      HorizontalContentAlignment="Left">
                            <ItemsPresenter x:Name="PART_ITEMSPRESENTER" />
                        </ScrollViewer>

                        <timelineControl:Timeline 
      x:Name="PART_TIMELINE"
      Direction="{TemplateBinding Direction}"      
      Grid.Column="1"
      VerticalAlignment="Top"
      HorizontalAlignment="Left"                      
      Width="{Binding ActualWidth , ElementName=PART_SCROLL_VIEWER}"
      Height="{Binding ActualHeight , ElementName=PART_SCROLL_VIEWER}">
                            <timelineControl:Timeline.Viewport>
                                <MultiBinding Converter="{StaticResource ViewportDirectionConverter}">
                                    <Binding Path="Direction" RelativeSource="{RelativeSource Mode=TemplatedParent}"></Binding>
                                    <Binding Path="ViewportX" RelativeSource="{RelativeSource Mode=TemplatedParent}"></Binding>
                                    <Binding Path="ViewportY" RelativeSource="{RelativeSource Mode=TemplatedParent}"></Binding>
                                </MultiBinding>
                            </timelineControl:Timeline.Viewport>
                        </timelineControl:Timeline>
                    </Grid>
                  
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>