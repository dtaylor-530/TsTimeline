<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:timelineControl="clr-namespace:TsTimeline">

    <Style TargetType="{x:Type timelineControl:Timeline}" >
        <Style.Resources>
            <Style TargetType="Thumb">
                <!--<Setter Property="Height"
           Value="{Binding ActualHeight , RelativeSource={RelativeSource AncestorType={x:Type Canvas}}}" />-->
                <!--つまみの見た目-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                          
                                    <Path  x:Name="PART_Path" 
                                            HorizontalAlignment="Center" Margin="0,-5,0,0"
                                           VerticalAlignment="Top"        
                                           SnapsToDevicePixels="True"
                                           UseLayoutRounding="True"
                                           Data="M10,0 
                                           H50 V40 
                                           H50 L30,65 
                                           L10,40 
                                           Z"
                                           Stretch="Uniform" Height="15" Stroke="Gray">
                                        <Path.Fill>
                                            <SolidColorBrush Opacity="0.3" Color="Gray"></SolidColorBrush>
                                        </Path.Fill>
                             
                                    </Path>
                      
                         
                            <ControlTemplate.Triggers>

                                <!-- When dragging -->  
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="PART_Path"
                                                                Property="Fill"
                                                                Value="BlueViolet"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="PART_Path"
                                                                Property="Fill"
                                                                Value="BlueViolet"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="Red" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Canvas x:Name="PART_CANVAS"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            ClipToBounds="{TemplateBinding ClipToBounds}">
                        <Rectangle x:Name="PART_RECTANGLE" 
                                   Fill="Plum"
                                   Margin="0,15,0,0"
                                   HorizontalAlignment="Left"
                                   Opacity="0.3"
                                   Height="{TemplateBinding Height}"></Rectangle>
                        <Rectangle Fill="Plum"
                                   x:Name="PART_LINE" 
                                   Margin="0,18,0,0"
                                   Height="{TemplateBinding Height}"
                                   Width="1">
                        </Rectangle>
                        <Thumb x:Name="PART_THUMB" 
                               Margin="0,10,0,0"
                               Cursor="Hand"
                               Height="{TemplateBinding Height}"
                               Width="30" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>