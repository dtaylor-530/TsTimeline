<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:timelineControl="clr-namespace:TsTimeline">


    <Style x:Key="Timeline_Thumb"  TargetType="{x:Type timelineControl:ClipBase}">
        <Style.Resources>
            <Style TargetType="Thumb">
                <!--<Setter Property="Height"
           Value="{Binding ActualHeight , RelativeSource={RelativeSource AncestorType={x:Type Canvas}}}" />-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Path  x:Name="PART_Path" 
                                   RenderTransformOrigin="0.5,0.5"
                                   HorizontalAlignment="Center"                                       
                                           SnapsToDevicePixels="True"
                                           UseLayoutRounding="True"                                   
                                           Data="M10,0 
                                           H50 V40 
                                           H50 L30,65 
                                           L10,40 
                                           Z"
                                   Stretch="Uniform" 
                                   Height="{TemplateBinding Height}" 
                                   Stroke="Gray">
                                <Path.Fill>
                                    <SolidColorBrush Opacity="0.3" Color="Gray"></SolidColorBrush>
                                </Path.Fill>                               
                                <Path.RenderTransform>
                                    <TransformGroup>                                    
                                        <RotateTransform
                                            Angle="{Binding Direction,
                            RelativeSource={RelativeSource AncestorType=timelineControl:ClipBase},
                                            ConverterParameter=Angle,
                            Converter={x:Static timelineControl:DirectionConverter.Instance}}" />

                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                            <ControlTemplate.Triggers>
                                <!-- When dragging -->  
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="PART_Path"
                                                                Property="Fill"
                                                                Value="BlueViolet"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="PART_Path"
                                                                Property="Fill"
                                                                Value="BlueViolet"/>
                                </Trigger>                                
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="Red" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type timelineControl:ClipBase}">
                    <!--<Canvas x:Name="PART_CANVAS"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding ActualHeight}"
                            >-->
                    <!--<Rectangle x:Name="PART_AREA" 
                                   Fill="Plum"
                                   Margin="0,0,0,0"
                               
                                   Opacity="0.3"                                       
                                   Width="{TemplateBinding Width}"
                                   Height="{TemplateBinding ActualHeight}"></Rectangle>-->
                    <!--<Rectangle Fill="Plum"
                                   x:Name="PART_LINE"                                  
                                   Width="1"
                                   Height="{TemplateBinding ActualHeight}"
                                   Margin="0,0,0,0">                           
                        </Rectangle>-->
                    <Thumb x:Name="PART_THUMB" 
                              
                               Cursor="Hand" />
                    <!--</Canvas>-->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--<Style x:Key="Timeline_Line"  TargetType="{x:Type timelineControl:ClipBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Fill="Plum"
                               x:Name="PART_LINE"  
                               Width="{TemplateBinding Width}"
                               Height="{TemplateBinding Height}"          
                               Margin="0,0,0,0">                             
                    </Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>-->

    <SolidColorBrush Color="#FF3BE400" Opacity="0.5" x:Key="Color"/>

    <Style x:Key="LineStyle"  TargetType="{x:Type timelineControl:ClipBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type timelineControl:ClipBase}">
                    <Rectangle 
                               x:Name="PART_LINE" 
                               Fill="{TemplateBinding Background}"
                               Opacity="{TemplateBinding Opacity}"
                               Width="{TemplateBinding Width}"
                               Height="{TemplateBinding Height}"          
                               Margin="0,0,0,0">                             
                    </Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AreaStyle"  TargetType="{x:Type timelineControl:ClipBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type timelineControl:ClipBase}">
                    <Rectangle 
                               x:Name="PART_AREA" 
                               Fill="{Binding Background, RelativeSource={RelativeSource Mode=TemplatedParent}, FallbackValue={StaticResource Color}}"
                               Opacity="{TemplateBinding Opacity}"
                               Width="{TemplateBinding Width}"
                               Height="{TemplateBinding Height}"          
                               Margin="0,0,0,0">                             
                    </Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>
    