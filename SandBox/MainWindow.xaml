<Window x:Class="SandBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SandBox"
        d:DataContext="{d:DesignInstance {x:Type local:MainWindowVm}}"
        xmlns:tsTimeline="clr-namespace:TsTimeline;assembly=TsTimeline"
        mc:Ignorable="d"
        Title="1000 tracks &amp; 3000 clips demo" Height="450" Width="800">
    <FrameworkElement.DataContext>
        <local:MainWindowVm/>
    </FrameworkElement.DataContext>
    <FrameworkElement.Resources>

        <local:CustomStyleSelector x:Key="CustomStyleSelector">
            <local:CustomStyleSelector.TriggerStyle>
                <Style TargetType="{x:Type tsTimeline:ClipBase}" BasedOn="{StaticResource TriggerClipStyle}">
                    <Setter Property="Value" Value="{Binding Value}"></Setter>
                </Style>
            </local:CustomStyleSelector.TriggerStyle>
            <local:CustomStyleSelector.HoldStyle>
                <Style TargetType="{x:Type tsTimeline:ClipBase}" BasedOn="{StaticResource HoldClipStyle}">
                    <Setter Property="StartValue" Value="{Binding StartValue}"></Setter>
                    <Setter Property="EndValue" Value="{Binding EndValue}"></Setter>
                </Style>
            </local:CustomStyleSelector.HoldStyle>
        </local:CustomStyleSelector>

        <local:ClipTemplateSelector x:Key="ClipTemplateSelector">
            <local:ClipTemplateSelector.TrackTemplate>
                <HierarchicalDataTemplate DataType="{x:Type local:TrackVm}" ItemsSource="{Binding Clips}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}"/>
                        <TextBox  Text="{Binding Min , Mode=OneWay}" IsReadOnly="True" Grid.Column="2"/>
                        <TextBox  Text="{Binding Max , Mode=OneWay}" IsReadOnly="True" Grid.Column="3"/>
                    </Grid>
                </HierarchicalDataTemplate>
            </local:ClipTemplateSelector.TrackTemplate>
        </local:ClipTemplateSelector>
    </FrameworkElement.Resources>

    <tsTimeline:TsTimeline Maximum="1000" ItemsSource="{Binding Tracks}"
                           ItemTemplateSelector="{StaticResource ClipTemplateSelector}"
                           ItemContainerStyleSelector="{StaticResource CustomStyleSelector}">
    </tsTimeline:TsTimeline>

    
</Window>
