<UserControl x:Class="SandBox.ConfigurationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SandBox"
             d:DataContext="{d:DesignInstance Type=local:ConfigurationViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <ComboBox x:Name="PART_COMBOBOX" SelectedItem="{Binding ChartType, Mode=TwoWay}" Height="25" Width="70"></ComboBox>    
    </Grid>
</UserControl>
