<UserControl x:Class="SandBox.ViewportUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SandBox"
             xmlns:tl="clr-namespace:Renderers;assembly=Renderers"
             d:DataContext="{d:DesignInstance tl:Viewport}"
             mc:Ignorable="d" 
             d:Background="White"
             d:DesignHeight="500" d:DesignWidth="80">
    <FrameworkElement.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                     <ResourceDictionary Source="/Resources/Paths.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type Slider}">
                <Setter Property="Width" Value="40"></Setter>
                <Setter Property="Margin" Value="4"></Setter>
            </Style>
            <Style TargetType="{x:Type Path}">
                <Setter Property="Width" Value="10"></Setter>
                <Setter Property="Stroke" Value="Transparent"></Setter>
                <Setter Property="Fill" Value="Gray"></Setter>
                <Setter Property="Stretch" Value="Uniform"></Setter>
            </Style>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="1"></Setter>
            </Style>
        </ResourceDictionary>
  
    </FrameworkElement.Resources>
    
    <Border BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10">

        <StackPanel>
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Path Data="{StaticResource Zoom}" ToolTip="Zoom"  ></Path>

                <StackPanel Grid.Column="1"
                 Orientation="Horizontal">

                    <Slider Minimum="1"
                 Maximum="4"
                 TickFrequency="0.1"

                 Value="{Binding Zoom,
                                 Mode=TwoWay}"/>

                    <TextBlock Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Zoom,
                                 
                                   StringFormat={}{0:F2} x}"/>
                </StackPanel>
            </Grid>

            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>



                <Path Data="{StaticResource Length}" ToolTip="Length" ></Path>


                <StackPanel Grid.Column="1"
                 Orientation="Horizontal">

                    <Slider Minimum="1"
                 Maximum="2000"
                 TickFrequency="10"     
                 Value="{Binding ViewportLength,
                                 Mode=TwoWay}"/>

                    <TextBlock Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding ViewportLength,
                                 
                                   StringFormat={}{0:F2}}"/>
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Path Data="{StaticResource Start}" ToolTip="Start" ></Path>


                <StackPanel Grid.Column="1"
                 Orientation="Horizontal">

                    <Slider Minimum="1"
                 Maximum="2000"
                 TickFrequency="10"
                 Value="{Binding WorldStart,
                                 Mode=TwoWay}"/>

                    <TextBlock Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding WorldStart, StringFormat={}{0:F2}}"/>
                </StackPanel>
            </Grid>
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Path Data="{StaticResource End}" ToolTip="End" ></Path>



                <StackPanel Grid.Column="1"
                 Orientation="Horizontal">

                    <Slider Minimum="1"
                 Maximum="2000"
                 TickFrequency="10"
                 Value="{Binding WorldEnd,
                                 Mode=TwoWay}"/>

                    <TextBlock Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding WorldEnd, StringFormat={}{0:F2}}"/>
                </StackPanel>
            </Grid>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                
                <Path Data="{StaticResource Spacing}" ToolTip="Minimum Pixel Spacing" ></Path>



                <StackPanel Grid.Column="1"
                 Orientation="Horizontal">

                    <Slider Minimum="5"
                 Maximum="50"
                 TickFrequency="5"
                            IsSnapToTickEnabled="True"
     
                 Value="{Binding MinPixelSpacing,
                                 Mode=TwoWay}"/>

                    <TextBlock Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding MinPixelSpacing,                                 
                                   StringFormat={}{0:F2}}"/>
                </StackPanel>
            </Grid>
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Path Data="{StaticResource Scale}" ToolTip="Scale" ></Path>



                <StackPanel Grid.Column="1"
                 Orientation="Horizontal">

                    <Slider Minimum="1"
                 Maximum="100"
                 Ticks="0.1, 0.5, 1, 2, 5, 10, 20, 50"
                            IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight"
         
                 Value="{Binding Scale,
                                 Mode=TwoWay}"/>

                    <TextBlock Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Scale,                             
                                   StringFormat={}{0:F2} x}"/>
                </StackPanel>
            </Grid>
            

        </StackPanel>
    </Border>
</UserControl>
