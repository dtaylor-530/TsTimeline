<UserControl x:Class="SandBox.ViewportUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SandBox"
             xmlns:tl="clr-namespace:TsTimeline;assembly=TsTimeline"
             d:DataContext="{d:DesignInstance tl:Viewport}"
             mc:Ignorable="d" 
             d:Background="White"
             d:DesignHeight="500" d:DesignWidth="180">
    
    <Border BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10">

        <StackPanel>
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Zoom X"
                VerticalAlignment="Center"
                Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1"
                 Orientation="Horizontal">

                    <Slider Minimum="1"
                 Maximum="4"
                 TickFrequency="0.1"
                 Width="150"
                 Value="{Binding ZoomX,
                                 Mode=TwoWay}"/>

                    <TextBlock Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding ZoomX,
                                 
                                   StringFormat={}{0:F2} x}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Viewport Width"
                VerticalAlignment="Center"
                Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1"
                 Orientation="Horizontal">

                    <Slider Minimum="1"
                 Maximum="2000"
                 TickFrequency="10"
                 Width="150"
                 Value="{Binding ViewportWidth,
                                 Mode=TwoWay}"/>

                    <TextBlock Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding ViewportWidth,
                                 
                                   StringFormat={}{0:F2}}"/>
                </StackPanel>
            </Grid>
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Viewport Height"
                VerticalAlignment="Center"
                Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1"
                 Orientation="Horizontal">

                    <Slider Minimum="1"
                 Maximum="2000"
                 TickFrequency="10"
                 Width="150"
                 Value="{Binding ViewportHeight,
                                 Mode=TwoWay}"/>

                    <TextBlock Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding ViewportHeight, StringFormat={}{0:F2}}"/>
                </StackPanel>
            </Grid>
            
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Min Pixel Spacing"
                VerticalAlignment="Center"
                Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1"
                 Orientation="Horizontal">

                    <Slider Minimum="5"
                 Maximum="50"
                 TickFrequency="5"
                            IsSnapToTickEnabled="True"
                 Width="150"
                 Value="{Binding MinPixelSpacing,
                                 Mode=TwoWay}"/>

                    <TextBlock Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding MinPixelSpacing,                                 
                                   StringFormat={}{0:F2}}"/>
                </StackPanel>
            </Grid>
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Scale X"
                VerticalAlignment="Center"
                Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1"
                 Orientation="Horizontal">

                    <Slider Minimum="1"
                 Maximum="100"
                 Ticks="0.1, 0.5, 1, 2, 5, 10, 20, 50"
                            IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight"
                 Width="150"
                 Value="{Binding ScaleX,
                                 Mode=TwoWay}"/>

                    <TextBlock Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding ScaleX,                             
                                   StringFormat={}{0:F2} x}"/>
                </StackPanel>
            </Grid>
            
            <!--<Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Scale X"
                VerticalAlignment="Center"
                Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1"
                 Orientation="Horizontal">

                    <Slider Minimum="1"
                 Maximum="4"
                 TickFrequency="0.1"
                 Width="150"
                 Value="{Binding ZoomX,
                                 Mode=TwoWay}"/>

                    <TextBlock Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding ZoomX,
                                 
                                   StringFormat={}{0:F2}x}"/>
                </StackPanel>
            </Grid>-->
        </StackPanel>
    </Border>
</UserControl>
