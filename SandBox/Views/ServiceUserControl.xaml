<UserControl x:Class="SandBox.ServiceUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SandBox"
             d:DataContext="{d:DesignInstance local:Factory}"
             mc:Ignorable="d" 
        d:Background="White"
         d:DesignWidth="80">
    <FrameworkElement.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Paths.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type Slider}">
                <Setter Property="Width" Value="40"></Setter>
                <Setter Property="Margin" Value="2,0"></Setter>
            </Style>
            <Style TargetType="{x:Type Path}">
                <Setter Property="Width" Value="10"></Setter>
                <Setter Property="Stroke" Value="Transparent"></Setter>
                <Setter Property="Fill" Value="Gray"></Setter>
                <Setter Property="Stretch" Value="Uniform"></Setter>
            </Style>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="1"></Setter>
            </Style>

            <local:LogConverter x:Key="LogConverter"/>
        </ResourceDictionary>

    </FrameworkElement.Resources>

    <Border BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="4"
            Margin="4"
            Padding="4">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Path Data="{StaticResource Count}" ToolTip="Count" ></Path>

                <StackPanel Grid.Column="1"
                 Orientation="Horizontal">

                    <Slider Minimum="10"
                 Maximum="200"
                 TickFrequency="10"
                            IsSnapToTickEnabled="True"
     
                 Value="{Binding Count,
                                 Mode=TwoWay}"/>

                    <TextBlock Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Count,                                 
                                   StringFormat={}{0}}"/>
                </StackPanel>
            </Grid>




            <!--<Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Path Data="{StaticResource Maximum}" ToolTip="Maximum Value" ></Path>



                <StackPanel Grid.Column="1"
                 Orientation="Horizontal">

                    <Slider Minimum="2"
                 Maximum="200"
                 TickFrequency="5"
                            IsSnapToTickEnabled="True"
     
                 Value="{Binding Maximum,
                                 Mode=TwoWay}"/>

                    <TextBlock Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Maximum,                                 
                                   StringFormat={}{0:F2}}"/>
                </StackPanel>
            </Grid>-->
        </StackPanel>
    </Border>
    
</UserControl>
