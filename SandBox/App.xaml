<Application x:Class="SandBox.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SandBox"
             xmlns:tsTimeline="clr-namespace:TsTimeline;assembly=TsTimeline">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TsTimeline;component/Themes/Generic.xaml" />

            </ResourceDictionary.MergedDictionaries>



            <local:ValueConverter x:Key="ValueConverter"/>

            <local:CustomStyleSelector x:Key="CustomStyleSelector">
                <local:CustomStyleSelector.TriggerStyle>
                    <Style TargetType="{x:Type tsTimeline:ClipBase}" BasedOn="{StaticResource TriggerClipStyle}">
                        <Setter Property="Value" Value="{Binding Value}"></Setter>
                    </Style>
                </local:CustomStyleSelector.TriggerStyle>
                <local:CustomStyleSelector.HoldStyle>
                    <Style TargetType="{x:Type tsTimeline:ClipBase}" BasedOn="{StaticResource HoldClipStyle}">
                        <Setter Property="StartValue" Value="{Binding StartValue}"></Setter>
                        <Setter Property="EndValue" Value="{Binding EndValue}"></Setter>
                    </Style>
                </local:CustomStyleSelector.HoldStyle>
                <local:CustomStyleSelector.BandStyle>
                    <Style TargetType="{x:Type tsTimeline:ClipBase}" BasedOn="{StaticResource {x:Type tsTimeline:ClipBase}}">
                        <Setter Property="StartValue" Value="{Binding StartValue}"></Setter>
                        <Setter Property="EndValue" Value="{Binding EndValue}"></Setter>
                        <Setter Property="Background" >
                            <Setter.Value>
                                <SolidColorBrush Color="CornflowerBlue" Opacity="0.5"></SolidColorBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type tsTimeline:ClipBase}" >
                                    <Canvas x:Name="PART_CANVAS"
                                                    Width="{TemplateBinding Width}"
                                                    Height="{TemplateBinding Height}">
                                        <Border
                                                    x:Name="PART_CENTER" 
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Width="{TemplateBinding Width}"
                                                    Height="{TemplateBinding Height}" ToolTip="{TemplateBinding EndValue}"/>
                                    </Canvas>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </local:CustomStyleSelector.BandStyle>
            </local:CustomStyleSelector>

            <local:ClipTemplateSelector x:Key="ClipTemplateSelector">
                <local:ClipTemplateSelector.TrackTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:TrackViewModel}" ItemsSource="{Binding Clips}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBox  Text="{Binding Min , Converter={StaticResource ValueConverter}, Mode=OneWay}" IsReadOnly="True" Grid.Column="2"/>
                            <TextBox  Text="{Binding Max , Converter={StaticResource ValueConverter}, Mode=OneWay}" IsReadOnly="True" Grid.Column="3"/>
                        </Grid>
                    </HierarchicalDataTemplate>
                </local:ClipTemplateSelector.TrackTemplate>
            </local:ClipTemplateSelector>

            <DataTemplate DataType="{x:Type local:PlayerViewModel}">
                <local:MediaUserControl  Margin="4">

                </local:MediaUserControl>
            </DataTemplate>

            <DataTemplate DataType="{x:Type tsTimeline:Viewport}">
                <local:ViewportUserControl  Margin="4">

                </local:ViewportUserControl>
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:SpeedViewModel}">
                <local:SpeedUserControl Margin="4">

                </local:SpeedUserControl>
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:ProgressViewModel}">
                <local:ProgressUserControl Margin="4" ValueConverter="{StaticResource ValueConverter}">

                </local:ProgressUserControl>
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:ChartViewModel}">
                <tsTimeline:ChartControl Series="{Binding Series}" 
                                             Viewport="{Binding Viewport}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:MainWindowViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{Binding Viewport}" Grid.Column="0"/>
                        <ContentControl Content="{Binding Player}" Grid.Column="1"/>
                        <ContentControl Content="{Binding Speed}" Grid.Column="2"/>
                        <ContentControl Content="{Binding Progress}" Grid.Column="3"/>
                    </Grid>

                    <tsTimeline:CombinedTimeline 
                        x:Name="CombinedTimeline"
                        Maximum="1000" 
                        ValueConverter="{StaticResource ValueConverter}"
                        Grid.Row="1"
                        Value="{Binding Progress.Progress, Mode=TwoWay}"
                        Viewport="{Binding Viewport}"
                        ItemsSource="{Binding Player.PlayList.Stacks}"
                        OffsetX="{Binding ElementName=TsTimeline, Path=OffsetX, Mode=OneWay}"
                        ItemTemplateSelector="{StaticResource ClipTemplateSelector}"
                        ItemContainerStyleSelector="{StaticResource CustomStyleSelector}">
                    </tsTimeline:CombinedTimeline>

                    <tsTimeline:TsTimeline 
                            x:Name="TsTimeline"
                            Maximum="1000" 
                        ValueConverter="{StaticResource ValueConverter}"
                        Grid.Row="2"
                        Value="{Binding Progress.Progress, Mode=TwoWay}"
                        Viewport="{Binding Viewport}"
                        ItemsSource="{Binding Player.PlayList.Tracks}"
                        ItemTemplateSelector="{StaticResource ClipTemplateSelector}"
                        ItemContainerStyleSelector="{StaticResource CustomStyleSelector}">
                    </tsTimeline:TsTimeline>

                    <StackPanel VerticalAlignment="Bottom" Grid.Row="1">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Tick Margin"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                                <Slider Minimum="1"
                        Maximum="100"
                        TickFrequency="0.1"
                        Width="150"
                        Value="{Binding ElementName=TsTimeline, Path=TickMargin,
                                        Mode=TwoWay}"/>

                                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding ElementName=TsTimeline, Path=TickMargin}"></TextBlock>


                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
