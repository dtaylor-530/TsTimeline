<Application x:Class="Demos.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Demos"
             xmlns:renderers="clr-namespace:Renderers;assembly=Renderers"
             xmlns:flags="clr-namespace:FamFamFam.Flags.Wpf;assembly=FamFamFam.Flags.Wpf"
             xmlns:views="clr-namespace:Views;assembly=Views"
             xmlns:hex="http://hexinnovation.com/math"
             xmlns:common="clr-namespace:Common;assembly=Common">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="/Resources/Paths.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Pen x:Key="BlackPen" 
            Thickness="0.5" 
            Brush="CornflowerBlue"
            LineJoin="Miter"
            StartLineCap="Square"
            EndLineCap="Square" />

            <SolidColorBrush x:Key="BandBrush" Color="CornflowerBlue" Opacity="0.5"/>
            <SolidColorBrush x:Key="HoldBrush" Color="#FF5DD17E" Opacity="0.5"/>
            <!--<SolidColorBrush x:Key="LandFill" Color="#FF00FFAC" />-->
            <DrawingBrush x:Key="CrossHatchBrush"
                  TileMode="Tile"
                  Viewport="0,0,4,4"
                  ViewportUnits="Absolute"
                  Viewbox="0,0,4,4"
                  ViewboxUnits="Absolute">

                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <!-- Background -->
                        <GeometryDrawing Brush="{StaticResource HoldBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,4,4"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>

                         <!--Diagonal lines-->
                        <GeometryDrawing Pen="{StaticResource BlackPen}">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,4" EndPoint="4,0"/>
                                    <LineGeometry StartPoint="0,0" EndPoint="4,4"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <SolidColorBrush x:Key="LandStroke" Color="#FF1A3217" />
  

            <local:BasicValueConverter x:Key="ValueConverter"/>
            <local:PanelTypeConverter x:Key="PanelTypeConverter"/>
            <local:ChildrenConverter x:Key="ChildrenConverter"/>
            <local:WidthConverter x:Key="WidthConverter"/>
            <local:DirectionToVisibilityConverter x:Key="DirectionToVisibilityConverter"/>
            <flags:CountryIdToFlagImageSourceConverter x:Key="CountryIdToFlagImageSourceConverter" />
            <local:IdToEnumConverter x:Key="IdToEnumConverter" />
            <hex:MathConverter x:Key="MathConverter"></hex:MathConverter>
            <local:AdditionConverter x:Key="AdditionConverter"></local:AdditionConverter>
            <local:CursorTypeToCursorConverter x:Key="CursorTypeToCursorConverter"></local:CursorTypeToCursorConverter>

            <Style x:Key="MasterStyle" TargetType="{x:Type views:ClipBase}" BasedOn="{StaticResource {x:Type TreeViewItem}}" >
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <views:FlexPanel Direction="{Binding DataContext.Direction, RelativeSource={RelativeSource AncestorType=TreeViewItem} }"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="IsExpanded" Value="True"></Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate  TargetType="{x:Type views:ClipBase}">
                            <ItemsPresenter x:Name="PART_ITEMS_PRESENTER" HorizontalAlignment="Left"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
            </Style>

            <Style x:Key="ConfigStyle" TargetType="{x:Type views:ClipBase}" BasedOn="{StaticResource {x:Type TreeViewItem}}" >
                <Setter Property="IsExpanded" Value="True"></Setter>
                <Setter Property="views:FlexPanel.GridLength" Value="{Binding GridLength}"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"></StackPanel>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="Loaded"
                     Handler="TreeViewItem_Loaded"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate  TargetType="{x:Type views:ClipBase}">
                            <ItemsPresenter x:Name="PART_ITEMS_PRESENTER" HorizontalAlignment="Left"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DefaultStyle" TargetType="{x:Type views:ClipBase}" BasedOn="{StaticResource {x:Type TreeViewItem}}" >
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalAlignment" Value="{Binding HorizontalAlignment}"></Setter>
                <Setter Property="IsExpanded" Value="True"></Setter>
                <Setter Property="views:FlexPanel.GridLength" Value="{Binding GridLength}"/>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
                <Setter Property="Margin" Value="{Binding Margin}"/>
            </Style>

            <Style x:Key="_TriggerClipStyle" TargetType="{x:Type views:ClipBase}" BasedOn="{StaticResource TriggerClipStyle}">
                <!--<Setter Property="X" Value="{Binding WorldX}"></Setter>-->
                <Setter Property="Canvas.Left" Value="{Binding WorldX}"></Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
            </Style>

       

            <Style x:Key="_BandClipStyle"  TargetType="{x:Type views:ClipBase}" BasedOn="{StaticResource BandClipStyle}">
                <Setter Property="Background" Value="{StaticResource BandBrush}"></Setter>
                <Setter Property="RenderOptions.EdgeMode" Value="Aliased"></Setter>
                <Setter Property="Height" Value="{Binding Height}"></Setter>
                <Setter Property="Canvas.Left" Value="{Binding WorldX}"></Setter>
                <Setter Property="Width" Value="{Binding WorldWidth, Mode=TwoWay}"/>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
            </Style>

            <Style x:Key="HoldClipThumbStyle" TargetType="{x:Type views:ClipBase}" >
                <Setter Property="Background" Value="{StaticResource CrossHatchBrush}"></Setter>
                <Setter Property="Grid.Column" Value="{Binding Column}"></Setter>
                <Setter Property="Cursor" Value="{Binding CursorType, Converter={StaticResource CursorTypeToCursorConverter}}"></Setter>
                <Setter Property="Opacity" Value="{Binding Opacity}"></Setter>
                <Setter Property="MinHeight" Value="15"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type views:ClipBase}">
                            <Thumb x:Name="PART_THUMB"   
                                   Style="{StaticResource HoldThumbStyle}"
                                   Height="{TemplateBinding Height}"
                                   Cursor="{TemplateBinding Cursor}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
            </Style>

            <Style x:Key="_HoldClipStyle"  TargetType="{x:Type views:ClipBase}" BasedOn="{StaticResource HoldClipStyle}">            
                <Setter Property="Canvas.Left" Value="{Binding WorldX}"></Setter>
                <Setter Property="Width" Value="{Binding WorldWidth, Mode=TwoWay}"/>
                <Setter Property="MinHeight" Value="5"></Setter>
                <Setter Property="Height" Value="{Binding Height}"></Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
            </Style>
            
            <Style x:Key="TitleStyle"  TargetType="{x:Type views:ClipBase}" >
                <Setter Property="Height" Value="24"></Setter>
                <Setter Property="Width" Value="80"/>
                <Setter Property="Canvas.Left" Value="{Binding X}"></Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate  TargetType="{x:Type views:ClipBase}">
                            <Grid>
                                <ContentPresenter ContentSource="Header"/>                            
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="_PointClipStyle"  TargetType="{x:Type views:ClipBase}" BasedOn="{StaticResource PointClipStyle}">
                <Setter Property="Width" Value="{Binding Width, FallbackValue=4}"></Setter>
                <Setter Property="Height" Value="{Binding Height, FallbackValue=4}"></Setter>
                <Setter Property="Canvas.Left" Value="{Binding WorldX}"></Setter>
                <Setter Property="Canvas.Top" Value="{Binding WorldY}"></Setter>
                <Setter Property="Background" Value="{Binding Background}"></Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
            </Style>


            <Style x:Key="ContentStyle" TargetType="{x:Type views:ClipBase}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type views:ClipBase}">
                            <Border Name="Bd" Background="{TemplateBinding Background}">
                                <ContentPresenter Name="PART_Header" 
                                                       ContentSource="Header" 
                                                       HorizontalAlignment="Left" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="Loaded"
                     Handler="TreeViewItem_Loaded"/>
            </Style>


            <Style x:Key="ChartLineStyle" TargetType="{x:Type views:ClipBase}">
                <Setter Property="views:Ex.Width" Value="{Binding WorldWidth}"></Setter>
                <Setter Property="views:Ex.Height" Value="{Binding WorldHeight}"></Setter>
                <Setter Property="views:Ex.X" Value="{Binding WorldX}"></Setter>
                <Setter Property="views:Ex.Y" Value="{Binding WorldY}"></Setter>
                <Setter Property="Background" Value="{Binding Background, FallbackValue=Black}"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type views:ClipBase}">
                              <Line
                                X1="{Binding (views:Ex.X), RelativeSource={RelativeSource Mode=TemplatedParent}}" 
                                Y1="{Binding (views:Ex.Y), RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                StrokeThickness="2"
                                Stroke="{Binding Background}">
                                <Line.X2>
                                    <MultiBinding ConverterParameter="(x+y)" Converter="{StaticResource AdditionConverter}">
                                        <Binding Path="(views:Ex.X)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="(views:Ex.Width)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Line.X2>
                                <Line.Y2>
                                    <MultiBinding ConverterParameter="(x+y)" Converter="{StaticResource AdditionConverter}">
                                        <Binding Path="(views:Ex.Y)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="(views:Ex.Height)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Line.Y2>
                            </Line>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
            </Style>

            <Style x:Key="RendererStyle" TargetType="{x:Type views:ClipBase}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type views:ClipBase}"/>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
                <EventSetter Event="Rendering" Handler="TreeViewItem_Rendering"/>
            </Style>

            <Style x:Key="ChartsStyle" TargetType="{x:Type views:ClipBase}" BasedOn="{StaticResource {x:Type TreeViewItem}}" >
                <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <UniformGrid IsItemsHost="True" Columns="1" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="views:FlexPanel.GridLength" Value="{Binding GridLength}"/>
                <EventSetter Event="Loaded"
                     Handler="TreeViewItem_Loaded"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate  TargetType="{x:Type views:ClipBase}">
                            <ItemsPresenter x:Name="PART_ITEMS_PRESENTER" Margin="30,0,0,0" HorizontalAlignment="Left"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CountryStyle" TargetType="{x:Type views:ClipBase}">
                <Setter Property="Canvas.Left" Value="{Binding UILeft}"></Setter>
                <Setter Property="Canvas.Top" Value="{Binding UITop}"></Setter>
                <Setter Property="Width" Value="{Binding UIWidth}"></Setter>
                <Setter Property="Height" Value="{Binding UIHeight}"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type views:ClipBase}">
                            <Path x:Name="PART_PATH">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="Fill" Value="{x:Static local:App.CountryBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource LandStroke}"/>
                                        <Setter Property="StrokeThickness" Value="0.5"/>
                                        <Setter Property="StrokeLineJoin" Value="Round"/>
                                        <Setter Property="Stretch" Value="Fill" />
                                    </Style>
                                </Path.Style>
                            </Path>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
            </Style>

            <Style x:Key="CountryItemStyle" TargetType="{x:Type views:ClipBase}" >
                <Setter Property="views:CustomPanel.ArrangeRect" Value="{Binding Position, Mode=OneWayToSource}" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <Grid/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
            </Style>
            <Style x:Key="ChartStyle"  TargetType="{x:Type views:ClipBase}">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <views:ExpandPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate  TargetType="{x:Type views:ClipBase}">
                            <ItemsPresenter x:Name="PART_ITEMS_PRESENTER" HorizontalAlignment="Left"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
            </Style>
            <Style x:Key="ChartObjectsStyle"  TargetType="{x:Type views:ClipBase}">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <views:ExpandPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate  TargetType="{x:Type views:ClipBase}">
                            <ItemsPresenter x:Name="PART_ITEMS_PRESENTER" HorizontalAlignment="Left"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
            </Style>

            <Style x:Key="TrackStyle"  TargetType="{x:Type views:ClipBase}">
                <Setter Property="Height" Value="{Binding Height}"></Setter>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <views:TrackPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate  TargetType="{x:Type views:ClipBase}">
                            <ItemsPresenter x:Name="PART_ITEMS_PRESENTER" HorizontalAlignment="Left"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
            </Style>

            <Style x:Key="PlaylistStyle"  TargetType="{x:Type views:ClipBase}">
                <Setter Property="views:Ex.PanelType" Value="{Binding PanelType}"/>
                <Setter Property="views:Ex.Direction" Value="{Binding Direction}"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <views:CustomPanel 
                                ScaleX="{Binding Zoom, Source={x:Static local:App.viewportX}}"
                                ScaleY="{Binding Zoom, Source={x:Static local:App.viewportY}}"
                                PanelType="{Binding Path=(views:Ex.PanelType), RelativeSource={RelativeSource AncestorType=TreeViewItem}}" 
                                Direction="{Binding Path=(views:Ex.Direction), RelativeSource={RelativeSource AncestorType=TreeViewItem}}" 
                                />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate  TargetType="{x:Type views:ClipBase}">
                            <ScrollViewer 
                                x:Name="PART_SCROLL_VIEWER"
                                HorizontalAlignment="Stretch" 
                                          VerticalAlignment="Stretch"    
                                          MinHeight="300"
                                          MinWidth="400"
                                          
                                          Background="Transparent"
                                          CanContentScroll="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          HorizontalContentAlignment="Left">

                                <ItemsPresenter x:Name="PART_ITEMS_PRESENTER"  HorizontalAlignment="Left"/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
            </Style>

            <Style x:Key="ProgressStyle"  TargetType="{x:Type views:ClipBase}">
                <Setter Property="views:CustomPanel.ArrangeRect" Value="{Binding Position, Mode=OneWayToSource}" />
                <Setter Property="Visibility" Value="{Binding Direction, Converter={StaticResource DirectionToVisibilityConverter}}"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <views:TimelinePanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate  TargetType="{x:Type views:ClipBase}">
                            <ItemsPresenter x:Name="PART_ITEMS_PRESENTER" HorizontalAlignment="Left"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
            </Style>

            <Style x:Key="TimelineThumbStyle"  TargetType="{x:Type views:ClipBase}" BasedOn="{StaticResource Timeline_Thumb}">
                <Setter Property="Visibility" Value="{Binding Direction, Converter={StaticResource DirectionToVisibilityConverter}}"/>
                <Setter Property="Width" Value="{Binding Width}"/>
                <Setter Property="Height" Value="{Binding Height}"/>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
                <Setter Property="HorizontalAlignment" Value="{Binding HorizontalAlignment}"/>
                <Setter Property="VerticalAlignment" Value="{Binding VerticalAlignment}"/>
                <Setter Property="Margin" Value="{Binding Margin}"/>
                <Setter Property="Canvas.Left" Value="{Binding X}" />
            </Style>


   

            <Style x:Key="_AreaStyle"  TargetType="{x:Type views:ClipBase}" BasedOn="{StaticResource AreaStyle}">
                <Setter Property="Visibility" Value="{Binding Direction, Converter={StaticResource DirectionToVisibilityConverter}}"/>
                <Setter Property="Background" Value="{Binding Background}"></Setter>
                <Setter Property="Width" Value="{Binding WorldWidth}"></Setter>
                <Setter Property="Height" Value="{Binding WorldHeight}"></Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
                <Setter Property="Opacity" Value="{Binding Opacity}"></Setter>
                <Setter Property="Canvas.Left" Value="{Binding WorldX}" />
                <Setter Property="Canvas.Top" Value="{Binding WorldY}" />
            </Style>

            <Style x:Key="_Area2Style"  TargetType="{x:Type views:ClipBase}" BasedOn="{StaticResource AreaStyle}">
                <Setter Property="Visibility" Value="{Binding Direction, Converter={StaticResource DirectionToVisibilityConverter}}"/>
                <Setter Property="Background" Value="{Binding Background}"></Setter>
                <Setter Property="Width" Value="{Binding Width}"></Setter>
                <Setter Property="Height" Value="{Binding Height}"></Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
                <Setter Property="Opacity" Value="{Binding Opacity}"></Setter>
                <Setter Property="Canvas.Left" Value="{Binding X}" />
                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type views:ClipBase}">
                            <Grid x:Name="PART_AREA">
                                <Grid.Resources>

                                    <Grid x:Key="WallpaperVisual" Background="Black">
                                        <Canvas>
                                            <Viewbox Width="20" Height="20"
                                                     Canvas.Left="0"
                                                     Canvas.Top="15">
                                                <Path Fill="#80AFB3A6" Data="{StaticResource Banjo}" ></Path>
                                            </Viewbox>

                                            <Viewbox Width="20" Height="20"
                                                     Canvas.Left="40"
                                                     Canvas.Top="15">
                                                <Path Fill="#80AFB3A6" Data="{StaticResource Beer}"/>
                                            </Viewbox>

                                            <Viewbox Width="20" Height="20"
                                                     Canvas.Left="20"
                                                     Canvas.Top="55">
                                                <Path Fill="#80AFB3A6" Data="{StaticResource Currencies}"/>
                                            </Viewbox>

                                            <!-- SVG #2 -->
                                            <Viewbox Width="20" Height="20"
                                                     Canvas.Left="60"
                                                     Canvas.Top="55">
                                                <Path Fill="#80AFB3A6" Data="{StaticResource Motorbike}"/>
                                            </Viewbox>
                                        </Canvas>
                                    </Grid>
                                </Grid.Resources>
                                <Border Background="Gray"></Border>
                                <!-- Main glass tint -->
                                <Border
                                    Background="#90FFFFFF"
                                    BorderBrush="#80FFFFFF"
                                    BorderThickness="1"/>

                                <!-- Gloss highlight -->
                                <Border IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#90FFFFFF" Offset="0"/>
                                            <GradientStop Color="#40FFFFFF" Offset="0.35"/>
                                            <GradientStop Color="#10FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="15"
                                            ShadowDepth="2"
                                            Opacity="0.3"/>
                                    </Border.Effect>
                                </Border>

                                <Grid>
                                    <Grid.Background>
                                        <VisualBrush Stretch="None"
                                                     TileMode="Tile"
                                                     Viewbox="0,0,80,80"
                                                     ViewboxUnits="Absolute"
                                                     Viewport="0,-15,80,80"
                                                     ViewportUnits="Absolute">
                                            <VisualBrush.Visual>
                                                <StaticResource ResourceKey="WallpaperVisual"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Grid.Background>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="_LineStyle"  TargetType="{x:Type views:ClipBase}" BasedOn="{StaticResource LineStyle}">
                <Setter Property="Background" Value="{Binding Background}"></Setter>
                <Setter Property="Width" Value="{Binding WorldWidth}"></Setter>
                <Setter Property="Height" Value="{Binding WorldHeight}"></Setter>
                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
                <Setter Property="Canvas.Left" Value="{Binding WorldX}" />
                <Setter Property="Canvas.Top" Value="{Binding WorldY}" />
            </Style>

            <local:CustomStyleSelector x:Key="CustomStyleSelector" 
                                       TriggerStyle="{StaticResource _TriggerClipStyle}"
                                       HoldStyle="{StaticResource _HoldClipStyle}"
                                       BandStyle="{StaticResource _BandClipStyle}"
                                       PointStyle="{StaticResource _PointClipStyle}"
                                       CountryStyle="{StaticResource CountryStyle}"
                                       CountryItemStyle="{StaticResource CountryItemStyle}"
                                       ContentStyle="{StaticResource ContentStyle}"
                                       DefaultStyle="{StaticResource DefaultStyle}"
                                       MasterStyle="{StaticResource MasterStyle}"
                                       ConfigStyle="{StaticResource ConfigStyle}"
                                       ChartStyle="{StaticResource ChartStyle}"
                                       ChartObjectsStyle="{StaticResource ChartObjectsStyle}"
                                       ChartsStyle="{StaticResource ChartsStyle}"                             
                                       ProgressStyle="{StaticResource ProgressStyle}"
                                       RendererStyle="{StaticResource RendererStyle}"
                                       PlaylistStyle="{StaticResource PlaylistStyle}"
                                       TrackStyle="{StaticResource TrackStyle}"
                                       AreaStyle="{StaticResource _AreaStyle}"
                                       Area2Style="{StaticResource _Area2Style}"
                                       LineStyle="{StaticResource _LineStyle}"
                                       TimelineThumbStyle="{StaticResource TimelineThumbStyle}"
                                       HoldClipThumbStyle="{StaticResource HoldClipThumbStyle}"
                                       TitleStyle="{StaticResource TitleStyle}"
                                       ChartLineStyle="{StaticResource ChartLineStyle}"
                                       >
            </local:CustomStyleSelector>
            

            <local:ClipTemplateSelector x:Key="ClipTemplateSelector">
                <local:ClipTemplateSelector.TrackTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:ViewModel}" ItemsSource="{Binding Children}">
                        <Grid>
                            <TextBlock Text="{Binding Name}"/>
                        </Grid>
                    </HierarchicalDataTemplate>
                </local:ClipTemplateSelector.TrackTemplate>
                <local:ClipTemplateSelector.CountryTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Converter={StaticResource ChildrenConverter}}"/>
                </local:ClipTemplateSelector.CountryTemplate>
                <local:ClipTemplateSelector.CountryNameTemplate>

                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"  
                                   Width="240" FontWeight="DemiBold" 
                                   FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </DataTemplate>
                </local:ClipTemplateSelector.CountryNameTemplate>
                <local:ClipTemplateSelector.CountryFlagTemplate>
                    <DataTemplate xmlns:flag="clr-namespace:Flags.Icons.WPF;assembly=Flags.Icons.WPF">
                        <!--<Image Source="{Binding Name, Converter={StaticResource CountryIdToFlagImageSourceConverter}}"
                                   Opacity="1"
                               HorizontalAlignment="Left"
                          Stretch="Uniform" Width="240" RenderOptions.BitmapScalingMode="HighQuality" />-->
                        <flag:FlagIcon Twemoji="{Binding Name, Converter={StaticResource IdToEnumConverter}}" Width="240" Height="40"  />
                    </DataTemplate>
                </local:ClipTemplateSelector.CountryFlagTemplate>
                <local:ClipTemplateSelector.SpeedTemplate>
                    <DataTemplate DataType="{x:Type local:ViewModel}">
                        <local:SpeedUserControl/>
                    </DataTemplate>
                </local:ClipTemplateSelector.SpeedTemplate>
                <local:ClipTemplateSelector.ServiceTemplate>
                    <DataTemplate DataType="{x:Type local:ViewModel}">
                        <local:ServiceUserControl Margin="1"/>
                    </DataTemplate>
                </local:ClipTemplateSelector.ServiceTemplate>         
                <local:ClipTemplateSelector.TitleTemplate>
                    <DataTemplate DataType="{x:Type local:ViewModel}">
                        <TextBlock Text="{Binding Name}"  
                                   FontWeight="DemiBold" 
                                   Opacity="0.3"
                                   FontSize="16" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"/>
                    </DataTemplate>
                </local:ClipTemplateSelector.TitleTemplate>
                <local:ClipTemplateSelector.TimeTemplate>
                    <DataTemplate DataType="{x:Type local:TimeService}">
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="4" Margin="4">
                       
                        <TextBlock Text="{Binding Progress, StringFormat=F2}" 
                                   FontWeight="DemiBold" 
                                   Opacity="0.8"
                                   FontSize="14" 
                                   Width="40"
                                   
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </local:ClipTemplateSelector.TimeTemplate>
                <local:ClipTemplateSelector.ChartTypeTemplate>
                    <DataTemplate DataType="{x:Type local:ViewModel}">
                        <Border BorderBrush="Gray" VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch" BorderThickness="1" CornerRadius="4" Margin="4">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Type" Margin="2" 
                     >
                                </TextBlock>
                                <ComboBox x:Name="PART_COMBOBOX" VerticalAlignment="Center" Margin="2" Grid.Row="1" 
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                    SelectedItem="{Binding Enum, Mode=TwoWay}" 
                    ItemsSource="{x:Static local:App.ChartTypes}"
                     Width="70">
                                </ComboBox>
                            </Grid>
                        </Border>
                    </DataTemplate>
                
                </local:ClipTemplateSelector.ChartTypeTemplate>

            </local:ClipTemplateSelector>

            <DataTemplate DataType="{x:Type local:MediaService}">
                <local:MediaUserControl  Margin="2"/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type common:Viewport}">
                <local:ViewportUserControl  Margin="4"/>
            </DataTemplate>





            <DataTemplate x:Key="Progress" DataType="{x:Type local:ViewModel}">
                <local:ProgressUserControl Margin="4" ValueConverter="{StaticResource ValueConverter}"/>
            </DataTemplate>

            <HierarchicalDataTemplate DataType="{x:Type common:Notification}" ItemsSource="{Binding Children, Mode=OneWay}">
                <TextBlock Text="{Binding Key}"></TextBlock>
            </HierarchicalDataTemplate>


        </ResourceDictionary>
    </Application.Resources>
</Application>
